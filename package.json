{
  "name": "gauri-site-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "bib": "python3 scripts/bib2json.py",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "python3 scripts/bib2json.py && tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 4174",
    "test:e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
