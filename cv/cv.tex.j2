  \if\relax\detokenize{#3}\relax\else{\sizeMeta\itshape #3\par}\nobreak\fi}
% Detail line: bold sentence-case label, no full stop at the end.
\newcommand{\cvmeta}[2]{{\sizeMeta\textbf{#1:} #2\par}}
% Description: full sentences, ending with a full stop.
\newcommand{\cvdesc}[1]{{\sizeEntry #1\par}}
% Compact list item (inside itemize): text ending with a full stop, optional date right-aligned.
\newcommand{\cvitem}[2]{\item\begin{tabularx}{\linewidth}[t]{@{}L@{\hspace{1em}}r@{}}#1 & \cvdate{#2}\end{tabularx}}
% Publication: [n] Authors. ``Title.'' \textit{Venue}, ..., year.  (hanging indent)
\newcommand{\pubitem}[2]{\cvgap{\sizeEntry\hangindent=2.2em\hangafter=1\noindent\makebox[2.2em][l]{[#1]}#2\par}}

