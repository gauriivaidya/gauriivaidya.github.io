\section{Professional Experience}
\cventry{Level 2 Postdoctoral Researcher}{2025--Present}{National Kidney Disease Surveillance System (NKDSS), University of Limerick, Ireland}
\cvmeta{Line managers}{Prof Austin Stack and Dr Leonard Browne}
\begin{itemize}
  \item Apply advanced data analysis and machine learning methods to quantify the burden and impact of chronic kidney disease in Ireland and support evidence-based prevention and intervention strategies.
  \item Develop a secure, linked health-data infrastructure integrating national hospital, registry, and population data to track Chronic Kidney Disease (CKD) prevalence, risk factors, outcomes, and quality of care.
\end{itemize}

\cventry{PhD Researcher}{2021--2025}{Biocomputing and Developmental Systems Research Group, University of Limerick, Ireland}
\cvmeta{Supervisors}{Prof Conor Ryan and Prof Meghana Kshirsagar}
\begin{itemize}
  \item Developed three hyperparameter-optimisation frameworks -- HyperEstimator, HyperGE, and PurGE -- achieving up to 2.2$\times$ faster convergence, 40\% energy savings, and 30\% lower memory use than comparator methods.
  \item Co-authored ten peer-reviewed publications and presented research through invited talks, technical presentations, workshops, and posters.
  \item Served as a teaching assistant and mentored undergraduate, master's, and internship projects in machine learning, software development, and applied AI.
  \item Managed the departmental NVIDIA A100 GPU server, including access control, resource allocation, and support for high-performance AI workloads with over 50 active users.
\end{itemize}

\cventry{Trainee Analyst}{2020--2021}{Principal Global Services, India}
\cvmeta{Manager}{Mr Shridhar More}
\begin{itemize}
  \item Automated health insurance workflows through full-stack Salesforce development, improving process efficiency by approximately 20\%.
  \item Invited to join the core development team within six months in recognition of commitment and technical contributions.
  \item Collaborated with international cross-functional teams on feature development and presented project outcomes and technical contributions to diverse stakeholders.
\end{itemize}

\cventry{Research Intern}{2019--2021}{Biocomputing and Developmental Systems Research Group, University of Limerick, Ireland}
\cvmeta{Supervisors}{Prof Conor Ryan and Dr Meghana Kshirsagar}
\begin{itemize}
  \item Developed a cryptographically secure pseudo-random number generator with Intel, validated against NIST SP 800-22 and published in \textit{Scientific Reports}.
  \item Built an Ethereum- and Neo4j-based framework for secure electronic health-record sharing under an EU Horizon 2020 project, with results published in \textit{Frontiers in Blockchain}.
\end{itemize}

